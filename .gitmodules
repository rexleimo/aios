[submodule "rex-harness"]
	path = rex-harness
	# HTTPS: GitHub Actions runners have no SSH keys, so an SSH URL here breaks
	# `submodules: recursive` checkout in release.yml (see v5.9.0 run #118).
	# Local machines behind SSH-port-22 firewalls should add a repo-local rewrite
	# instead of changing this URL:
	#   git config url."ssh://git@ssh.github.com:443/".insteadOf "https://github.com/"
	url = https://github.com/rexleimo/rex-harness.git
