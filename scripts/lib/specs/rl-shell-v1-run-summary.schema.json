{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://scripts/lib/specs/rl-shell-v1-run-summary.schema.json",
  "title": "AIOS Shell RL V1 Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "spec_path",
    "student_model_id",
    "primary_teacher",
    "fallback_order",
    "train_split",
    "held_out_split",
    "best_checkpoint_path",
    "best_metrics",
    "updates_completed",
    "updates_failed",
    "rollbacks_completed",
    "replay_only_epochs",
    "comparison_failed_count",
    "seed_results",
    "status"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "spec_path": { "type": "string", "minLength": 1 },
    "student_model_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "primary_teacher": { "type": "string", "minLength": 1 },
    "fallback_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "train_split": { "type": "string", "minLength": 1 },
    "held_out_split": { "type": "string", "minLength": 1 },
    "best_checkpoint_path": { "type": "string", "minLength": 1 },
    "best_metrics": { "type": "object" },
    "updates_completed": { "type": "integer", "minimum": 0 },
    "updates_failed": { "type": "integer", "minimum": 0 },
    "rollbacks_completed": { "type": "integer", "minimum": 0 },
    "replay_only_epochs": { "type": "integer", "minimum": 0 },
    "comparison_failed_count": { "type": "integer", "minimum": 0 },
    "seed_results": {
      "type": "array",
      "items": { "type": "object" }
    },
    "replay_pool_status": { "type": "string", "minLength": 1 },
    "better_count": { "type": "integer", "minimum": 0 },
    "same_count": { "type": "integer", "minimum": 0 },
    "worse_count": { "type": "integer", "minimum": 0 },
    "teacher_shaping_alignment_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "active_checkpoint_id": { "type": "string", "minLength": 1 },
    "pre_update_ref_checkpoint_id": { "type": "string", "minLength": 1 },
    "last_stable_checkpoint_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 }
  }
}
